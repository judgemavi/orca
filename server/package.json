{
  "name": "@orca/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/api/routes.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@hono/zod-validator": "^0.7.6",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@orca/types": "../packages/types",
    "commander": "^14.0.3",
    "deepmerge": "^4.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "4.12.5",
    "tree-kill": "^1.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3"
  }
}
