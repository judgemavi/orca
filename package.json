{
  "name": "orca-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd web dev",
    "build:web": "bun run --cwd web build",
    "dev:server": "bun run --cwd server dev",
    "build:server": "bun run --cwd server build",
    "check": "bun --filter='*' --elide-lines=0 check",
    "check:fix": "bun --filter='*' --elide-lines=0 check:fix",
    "format": "bun --filter='*' --elide-lines=0 format",
    "format:fix": "bun --filter='*' --elide-lines=0 format:fix",
    "lint": "bun --filter='*' --elide-lines=0 lint",
    "lint:fix": "bun --filter='*' --elide-lines=0 lint:fix",
    "typecheck": "bun --filter='*' --elide-lines=0 typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.10",
    "knip": "^5.85.0"
  }
}
