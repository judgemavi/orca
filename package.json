{
  "name": "orca-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd web dev",
    "build:web": "bun run --cwd web build",
    "dev:server": "bun run --cwd server dev",
    "build:server": "bun run --cwd server build",
    "typecheck": "bun run --cwd server typecheck && bun run --cwd web build"
  },
  "devDependencies": {
    "knip": "^5.85.0"
  }
}
