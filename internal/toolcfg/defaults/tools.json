{
  "tools": {
    "claude": {
      "binary": "claude",
      "models": [
        "claude-opus-4-6",
        "claude-sonnet-4-6",
        "claude-haiku-4-5-20251001",
        "claude-opus-4-5-20251101",
        "claude-sonnet-4-5-20250929"
      ],
      "args": [
        { "param": "-p", "variable": "prompt", "used_in": ["headless"] },
        { "param": "--resume", "variable": "session_id", "used_in": ["resume"] },
        { "param": "-p", "variable": "feedback", "used_in": ["resume"] },
        { "param": "--mcp-config", "variable": "mcp_config", "used_in": ["interactive"] },
        { "param": "--allowedTools", "variable": "allowed_tools", "used_in": ["interactive"] },
        { "param": "--append-system-prompt", "variable": "context", "used_in": ["interactive"] },
        { "param": "--output-format", "value": "stream-json", "used_in": ["headless", "resume"] },
        { "param": "--verbose", "used_in": ["headless", "resume"] },
        { "param": "--include-partial-messages", "used_in": ["headless", "resume"] },
        { "param": "--permission-mode", "value": "bypassPermissions", "used_in": ["headless", "resume"] },
        { "param": "--model", "variable": "model", "used_in": ["headless", "interactive", "resume"] }
      ],
      "session_id": { "mode": "json", "key": "session_id" },
      "timeout": "600s"
    },
    "codex": {
      "binary": "codex",
      "models": [
        "gpt-5.3-codex",
        "gpt-5.2-codex",
        "gpt-5.1-codex-max",
        "gpt-5.1-codex",
        "gpt-5-codex",
        "gpt-5-codex-mini"
      ],
      "args": [
        { "param": "-a", "value": "never", "used_in": ["interactive"] },
        { "param": "--json", "used_in": ["headless", "resume"] },
        { "param": "--full-auto", "used_in": ["headless", "resume"] },
        { "param": "-C", "variable": "dir", "used_in": ["headless", "resume"] },
        { "param": "--prompt", "variable": "prompt", "used_in": ["headless"] },
        { "param": "--prompt", "variable": "feedback", "used_in": ["resume"] },
        { "param": "--resume", "variable": "session_id", "used_in": ["resume"] },
        { "param": "--prompt", "variable": "context", "used_in": ["interactive"] },
        { "param": "--model", "variable": "model", "used_in": ["headless", "interactive", "resume"] }
      ],
      "session_id": { "mode": "json", "key": "thread_id" },
      "timeout": "600s"
    }
  }
}
